# Copy to `.env` before local `docker compose` / `docker compose -f docker-compose.dev.yml`
#   cp .env.docker.example .env
#
# Production (`docker compose up`) requires a strong POSTGRES_PASSWORD and JWT_SECRET
# with no working defaults. Postgres is not published to the host in production.

POSTGRES_USER=postgres
# Required for production compose (no default). Dev compose may still default to postgres.
POSTGRES_PASSWORD=
POSTGRES_DB=taxi
# Host port mapping — used by docker-compose.dev.yml only (prod does not publish DB).
POSTGRES_PORT=5434
APP_PORT=3000

# Required — unique random string ≥32 characters (openssl rand -base64 48).
# Placeholders like "change-me-to-a-long-random-string" are rejected at runtime.
JWT_SECRET=

# Public URL of this deployment (used for PayPal returns, absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo seed creates ops@transfers.co / admin123 with requiresPasswordReset.
# Refused when NODE_ENV=production (entrypoint + seed both fail closed).
# Safe for local/dev only:
SEED_ON_START=false

# Optional — Web Push (npx web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@transfers.co

# Optional — Stripe / PayPal (or configure later in Admin → Settings)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
