# Environment variables — never commit real secrets
.env
.env*.local
.env.production
.env.staging
.env.docker
# Keep tracked templates
!.env.example
!.env.docker.example
!.env.*.example

# Dependencies
node_modules

# Next.js
.next/
.next-dev/
.next-local/
out/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS / editor
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel
.vercel/

# User-uploaded CMS images (keep folder via .gitkeep)
public/uploads/pages/*
!public/uploads/pages/.gitkeep
